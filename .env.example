# ==============================================================================
# UBUNTU REALTIME SERVER SENTINEL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for your Ubuntu server environment
# ==============================================================================

# Server Network Binding & Port
# In production, keep HOST=127.0.0.1 so Node is only reachable via Nginx or SSH tunnel
HOST=127.0.0.1
PORT=3004
TRUST_PROXY=1

# Server Execution Environment (development | production)
NODE_ENV=development

# MongoDB Connection String (Required for authentication, history, and alerts)
# Example for MongoDB Atlas Cluster:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ubuntu_monitor?retryWrites=true&w=majority
# Default local fallback:
MONGODB_URI=mongodb://127.0.0.1:27017/ubuntu_monitor

# JWT Authentication Secret Key (REQUIRED in production, min 32 chars)
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Cookie & CORS Hardening
# COOKIE_SECURE: auto (uses HTTPS detection) | true | false
COOKIE_SECURE=auto
# CORS_ORIGIN: optional comma-separated allowlist (e.g. https://monitor.example.com)
# Leave empty to restrict to same-host origin only
CORS_ORIGIN=

# Registration Lock (Set to true after creating your single admin account)
DISABLE_REGISTRATION=false

# Performance & Data Sampling Intervals (Low-Overhead Controls)
# SAMPLING_INTERVAL_MS: Realtime WebSockets tick rate (ms)
SAMPLING_INTERVAL_MS=2000

# DB_PERSIST_INTERVAL_MS: MongoDB background persistence interval (ms)
DB_PERSIST_INTERVAL_MS=15000

# System Access Log File Tailing (Opt-in)
# Keep false on shared servers unless you explicitly want to monitor co-hosted apps
ENABLE_SYSTEM_LOG_TAILER=false
# Comma-separated list with optional "label:path"
# Supports Nginx/Apache Combined logs, JSON HTTP logs, Winston JSON/text logs, and daily-rotating wildcards (*)
# Example:
# LOG_FILE_PATHS=bahari-api:/var/www/cashier-app/logs/http.log,bahari-client:/var/log/nginx/bahari-client-access.log,wa-bot:/var/www/whatsapp_gpib_imm/logs/combined-*.log
LOG_FILE_PATHS=
# Single-file fallback (optional)z
LOG_FILE_PATH=/var/log/nginx/monitor-access.log

# Security Anomaly Detection Thresholds
ANOMALY_CPU_THRESHOLD=85
ANOMALY_RAM_THRESHOLD=90
ANOMALY_DISK_THRESHOLD=90
TRAFFIC_ANOMALY_THRESHOLD=120
