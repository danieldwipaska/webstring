# ==============================================================================
# UBUNTU REALTIME SERVER SENTINEL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for your Ubuntu server environment
# ==============================================================================

# Server HTTP Port
PORT=5000

# Server Execution Environment (development | production)
NODE_ENV=development

# MongoDB Atlas Connection String
# Example for MongoDB Atlas Cluster:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ubuntu_monitor?retryWrites=true&w=majority
# Default local fallback:
MONGODB_URI=mongodb://127.0.0.1:27017/ubuntu_monitor

# JWT Authentication Secret Key (Change this to a strong random string)
JWT_SECRET=super_secret_ubuntu_monitor_key_2026

# Performance & Data Sampling Intervals (Low-Overhead Controls)
# SAMPLING_INTERVAL_MS: Realtime WebSockets tick rate (ms)
SAMPLING_INTERVAL_MS=2000

# DB_PERSIST_INTERVAL_MS: MongoDB Atlas background persistence interval (ms)
DB_PERSIST_INTERVAL_MS=15000

# System Access Log File Path (Optional Custom Web Server Access Log)
# Leave empty to auto-detect /var/log/nginx/access.log, /var/log/apache2/access.log
LOG_FILE_PATH=/var/log/nginx/access.log

# Security Anomaly Detection Thresholds
ANOMALY_CPU_THRESHOLD=85
ANOMALY_RAM_THRESHOLD=90
ANOMALY_DISK_THRESHOLD=90
