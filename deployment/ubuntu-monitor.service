[Unit]
Description=Ubuntu Realtime Server Sentinel Service
After=network.target mongod.service

[Service]
Type=simple
User=ubuntu-monitor
Group=ubuntu-monitor
WorkingDirectory=/opt/ubuntu-monitor
EnvironmentFile=/opt/ubuntu-monitor/.env
ExecStart=/usr/bin/node /opt/ubuntu-monitor/server/index.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=5000

# Systemd Process Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ubuntu-monitor

[Install]
WantedBy=multi-user.target
